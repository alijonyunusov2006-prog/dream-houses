# Скопировать в .env (в корне jarvis/) и заполнить. Файл .env в Git не попадает.

TELEGRAM_BOT_TOKEN=
OWNER_CHAT_ID=

# Шлюз (этап 3)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# DH OS (CRM владельца) — ключ помощника для MCP-сервера https://dh-os-dh-a16d.vercel.app/api/mcp
# Выдаёт владелец командой в папке web проекта DH OS:  npx tsx scripts/agent-key.ts выдать <почта> Джарвис
# Ключ работает от имени владельца (видит зарплаты и доли) — хранить ТОЛЬКО на этом ПК, никогда в облаке и в Git.
# Claude Code читает его из переменной окружения: setx DHOS_AGENT_KEY "<ключ>"  (или Диспетчер учётных данных).
DHOS_AGENT_KEY=

# Старый способ (прямой доступ к базе) — не нужен, если работает DH OS MCP
CRM_SUPABASE_URL=
CRM_SUPABASE_KEY=

# Голос — только локальные движки (Qwen3-TTS / Chatterbox / Piper), ключи не нужны.

# Принтеры (этап 6)
# Bambu Lab P1S — LAN-only Mode + Developer Mode включены на принтере
BAMBU_P1S_IP=
BAMBU_P1S_ACCESS_CODE=
BAMBU_P1S_SERIAL=
# Creality K1 — root + Moonraker (helper script)
CREALITY_K1_IP=
CREALITY_K1_MOONRAKER_PORT=7125
CREALITY_K1_API_KEY=
# Telegram-бот Qabat (BotFather). Токен — только здесь, в .env на ПК, или в переменных облачного окружения. Не в чат и не в Git
QABAT_TG_BOT_TOKEN=
